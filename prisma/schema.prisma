generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////
enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum EventType {
  EXHIBITION
  WORKSHOP
  PERFORMANCE
  CONFERENCE
  OTHER
}

enum EventPhotoType {
  HERO
  PROMO
  MEMORY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InstitutionType {
  EDUCATIONAL
  INDEPENDENT
}

enum InstitutionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum ContentRequestType {
  CATEGORY
  STYLE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

//////////////////////////////////////////////////////
// USER TYPES
//////////////////////////////////////////////////////

model UserTypes {
  uid        String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(30) @unique

  users      Users[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// ROLES
//////////////////////////////////////////////////////

model Roles {
  uid       String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(50) @unique
  slug      String   @db.VarChar(30) @unique

  users     Users[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////

model Users {
  uid            String    @id @unique @db.Uuid
  name           String    @db.VarChar(30)
  lastName       String    @db.VarChar(30)
  username       String    @db.VarChar(30) @unique
  description    String?   @db.VarChar(500)

  gender         String    @db.VarChar(3)
  telNumber      String    @db.VarChar(12)

  isActive       Boolean   @default(true)

  userType       UserTypes @relation(fields: [userTypeId], references: [uid])
  userTypeId     String    @db.Uuid
  photo          Photos?   @relation("UserPhoto", fields: [photoId], references: [uid])
  photoId        String?   @unique @db.Uuid
  role           Roles?    @relation(fields: [roleId], references: [uid])
  roleId         String?   @db.Uuid
  roleData       Json?

  groups         UsersGroups[]
  products       UserProduct[]
  managedGroups  Groups[]  @relation("GroupProfesor")
  createdEvents  Events[]  @relation("EventCreator")
  attendance     Attendance[]
  userInstitutions       UserInstitution[]
  institutionInvitations InstitutionInvitation[]
  lessonsAuthored Lessons[]        @relation("LessonAuthor")
  lessonProgress  LessonProgress[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishAt    DateTime?
}

model Credentials {
  uid              String    @id @default(uuid()) @db.Uuid
  mail             String    @db.VarChar(100) @unique
  password         String    @db.VarChar(250)
  isEmailVerified  Boolean   @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  finishedAt       DateTime?
}

model VerificationCodes {
  uid           String    @id @default(uuid()) @db.Uuid
  credentialUid String    @db.Uuid
  code          String    @db.VarChar(6)
  expiresAt     DateTime
  usedAt        DateTime?

  createdAt     DateTime  @default(now())

  @@index([credentialUid])
}

//////////////////////////////////////////////////////
// GROUPS
//////////////////////////////////////////////////////

model Groups {
  uid          String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  isActive     Boolean  @default(true)

  /// Descripción pública del grupo. La escribe el docente a cargo.
  description  String?  @db.VarChar(500)

  /// Reglas del grupo, texto libre escrito por el docente. Son informativas:
  /// el sistema NO las hace cumplir. Ver
  /// docs/superpowers/specs/2026-08-11-modelo-de-grupos-design.md § 3.
  rules        String?  @db.Text

  /// Portada del grupo, subida por el docente. Si es null, el frontend cae en
  /// la imagen de la categoría (`categoryImage(slug)`).
  coverPhotoId String?  @db.Uuid
  coverPhoto   Photos?  @relation("GroupCover", fields: [coverPhotoId], references: [uid])

  institutionId  String       @db.Uuid
  institution    Institution  @relation(fields: [institutionId], references: [uid])
  categoryId     String       @db.Uuid
  groupCategory  GroupCategory @relation(fields: [categoryId], references: [uid])

  profesor     Users?   @relation("GroupProfesor", fields: [profesorId], references: [uid])
  profesorId   String?  @db.Uuid

  users        UsersGroups[]
  products     Products[]
  events       GroupEvent[]
  invitations  EventInvitation[]
  schedules    Schedule[]
  classes      Classes[]
  lessons      Lessons[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([institutionId])
}

model UsersGroups {
  uid       String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  groupId   String   @db.Uuid

  user      Users    @relation(fields: [userId], references: [uid])
  group     Groups   @relation(fields: [groupId], references: [uid])

  createdAt DateTime @default(now())

  @@unique([userId, groupId])
}

//////////////////////////////////////////////////////
// PRODUCTS
//////////////////////////////////////////////////////

model Products {
  uid          String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(100)
  description  String        @db.VarChar(500)
  
  status       ProductStatus @default(PENDING)
  feedback     String?       @db.VarChar(300)
  isActive     Boolean       @default(true)

  price        Decimal?      @db.Decimal(10,2)
  isSold       Boolean       @default(false)
  madeAt       DateTime

  // Audio de la obra, para la categoria `musica`. Nullable: en una pintura va null.
  // Guarda la ruta publica que devuelve photoManagement con AUDIO_ROOT
  // (`/audio/<carpeta>/<uuid>.mp3`), no el archivo. MVP = una cancion por obra;
  // los albumes con varias pistas estan en obsidian/Tareas/Musica-Lo-que-falta.
  audioUrl     String?       @db.VarChar(500)
  
  groupId      String        @db.Uuid
  group        Groups        @relation(fields: [groupId], references: [uid])

  institutionId String       @db.Uuid
  institution   Institution  @relation(fields: [institutionId], references: [uid])

  styles       ProductStyle[]
  photos       ProductPhoto[]
  events       EventProduct[]
  authors      UserProduct[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([institutionId])
  @@index([institutionId, status])
}

//////////////////////////////////////////////////////
// STYLES
//////////////////////////////////////////////////////

/// Catálogo de estilos de la plataforma, igual que `GroupCategory`: **no tiene
/// tenant**. No está en SCOPED_MODELS, no lleva `institutionId` y solo lo
/// escribe `super_admin`.
///
/// Antes colgaba de un grupo (`groupId`) Y de una institución, así que el mismo
/// catálogo existía repetido una vez por grupo de artes: tres filas "Acuarela",
/// una por institución. La galería pública tenía que colapsarlas por nombre
/// para no mostrar el filtro triplicado, y el filtro tenía que buscar por
/// nombre en vez de por uid para no esconder las obras de las otras.
/// Ver obsidian/errors/products/2026-08-24-la-galeria-vacia-por-un-undefined.md
///
/// Un estilo pertenece a una categoría y a nada más. El nombre puede repetirse
/// **entre** categorías —"Contemporáneo" existe en Danzas y en Música— pero no
/// dentro de una: eso es lo que fija `@@unique([name, categoryId])`.
model Styles {
  uid          String          @id @default(uuid()) @db.Uuid
  name         String          @db.VarChar(30)
  description  String          @db.VarChar(300)
  isActive     Boolean         @default(true)

  categoryId    String          @db.Uuid
  groupCategory GroupCategory   @relation(fields: [categoryId], references: [uid])

  products     ProductStyle[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([name, categoryId])
  @@index([categoryId])
}

model ProductStyle {
  uid        String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  styleId    String   @db.Uuid

  product    Products @relation(fields: [productId], references: [uid])
  style      Styles   @relation(fields: [styleId], references: [uid])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, styleId])
}

//////////////////////////////////////////////////////
// PHOTOS
//////////////////////////////////////////////////////

model Photos {
  uid        String         @id @default(uuid()) @db.Uuid
  name       String         @db.VarChar(100)
  url        String         @db.VarChar(500)

  products   ProductPhoto[]
  events     EventPhoto[]
  user       Users?         @relation("UserPhoto")
  groupCovers Groups[] @relation("GroupCover")
  lessonCovers  Lessons[]      @relation("LessonCover")
  chapterPhotos ChapterPhoto[]

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model ProductPhoto {
  uid        String    @id @default(uuid()) @db.Uuid
  productId  String    @db.Uuid
  photoId    String    @db.Uuid
  isMain     Boolean   @default(false)

  product    Products @relation(fields: [productId], references: [uid])
  photo      Photos   @relation(fields: [photoId], references: [uid])

  createdAt  DateTime  @default(now())

  @@unique([productId, photoId])
}

//////////////////////////////////////////////////////
// EVENTS
//////////////////////////////////////////////////////

model Events {
  uid          String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(100)
  description  String      @db.VarChar(1000)
  status       EventStatus @default(PENDING)
  feedback     String?     @db.VarChar(500)
  eventType    EventType   @default(EXHIBITION)
  startDate    DateTime
  endDate      DateTime?
  locationUrl  String?     @db.VarChar(500)
  isVirtual    Boolean     @default(false)
  streamingUrl String?     @db.VarChar(500)
  isActive     Boolean     @default(true)

  createdBy    Users       @relation("EventCreator", fields: [createdById], references: [uid])
  createdById  String      @db.Uuid

  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [uid])

  products     EventProduct[]
  photos       EventPhoto[]
  groups       GroupEvent[]
  invitations  EventInvitation[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([institutionId])
  @@index([institutionId, startDate])
}

model EventProduct {
  uid        String    @id @default(uuid()) @db.Uuid
  productId  String    @db.Uuid
  eventId    String    @db.Uuid

  product    Products @relation(fields: [productId], references: [uid])
  event      Events   @relation(fields: [eventId], references: [uid])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([productId, eventId])
}

model EventInvitation {
  uid         String           @id @default(uuid()) @db.Uuid
  eventId     String           @db.Uuid
  groupId     String           @db.Uuid
  status      InvitationStatus @default(PENDING)

  event       Events  @relation(fields: [eventId], references: [uid])
  group       Groups  @relation(fields: [groupId], references: [uid])

  sentAt      DateTime  @default(now())
  respondedAt DateTime?
  updatedAt   DateTime  @updatedAt  

  @@unique([eventId, groupId])
}

model EventPhoto {
  uid        String         @id @default(uuid()) @db.Uuid
  eventId    String         @db.Uuid
  photoId    String         @db.Uuid
  photoType  EventPhotoType @default(PROMO)

  event      Events  @relation(fields: [eventId], references: [uid])
  photo      Photos  @relation(fields: [photoId], references: [uid])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([eventId, photoId])
}

//////////////////////////////////////////////////////
// USERS ↔ PRODUCTS (AUTHOR)
//////////////////////////////////////////////////////

model UserProduct {
  uid        String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  productId  String    @db.Uuid
  isAuthor   Boolean   @default(false)

  user       Users     @relation(fields: [userId], references: [uid])
  product    Products  @relation(fields: [productId], references: [uid])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, productId])
}

//////////////////////////////////////////////////////
// GROUPS ↔ EVENTS
//////////////////////////////////////////////////////

model GroupEvent {
  uid        String   @id @default(uuid()) @db.Uuid
  groupId    String   @db.Uuid
  eventId    String   @db.Uuid

  group      Groups   @relation(fields: [groupId], references: [uid])
  event      Events   @relation(fields: [eventId], references: [uid])

  createdAt  DateTime @default(now())

  @@unique([groupId, eventId])
}

//////////////////////////////////////////////////////
// SCHEDULE & CLASSES
//////////////////////////////////////////////////////

model Schedule {
  uid        String   @id @default(uuid()) @db.Uuid
  groupId    String   @db.Uuid
  dayOfWeek  Int      // 0=Dom, 1=Lun, 2=Mar, 3=Mié, 4=Jue, 5=Vie, 6=Sáb
  startTime  String   @db.VarChar(5)  // "HH:mm"
  endTime    String   @db.VarChar(5)  // "HH:mm"
  isActive   Boolean  @default(true)

  group      Groups   @relation(fields: [groupId], references: [uid])
  classes    Classes[]

  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [uid])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([institutionId])
}

model Classes {
  uid        String    @id @default(uuid()) @db.Uuid
  groupId    String    @db.Uuid
  scheduleId String?   @db.Uuid  // null = clase manual
  date       DateTime
  startTime  String    @db.VarChar(5)  // "HH:mm"
  endTime    String    @db.VarChar(5)  // "HH:mm"
  topic      String?   @db.VarChar(500)
  review     String?   @db.VarChar(1000)
  isActive   Boolean   @default(true)

  group      Groups    @relation(fields: [groupId], references: [uid])
  schedule   Schedule? @relation(fields: [scheduleId], references: [uid])
  attendance Attendance[]

  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [uid])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([institutionId])
  @@index([institutionId, date])
}

model Attendance {
  uid      String   @id @default(uuid()) @db.Uuid
  classId  String   @db.Uuid
  userId   String   @db.Uuid
  takenAt  DateTime @default(now())

  class    Classes  @relation(fields: [classId], references: [uid])
  user     Users    @relation(fields: [userId], references: [uid])

  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [uid])

  @@unique([classId, userId])
  @@index([institutionId])
}

//////////////////////////////////////////////////////
// SUBSCRIPTION PLANS
//////////////////////////////////////////////////////

model SubscriptionPlan {
  uid           String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(50) @unique
  slug          String        @db.VarChar(30) @unique
  features      Json
  maxUsers      Int?
  maxGroups     Int?
  priceUsd      Decimal?      @db.Decimal(10,2)
  stripePriceId String?       @db.VarChar(100)
  isActive      Boolean       @default(true)

  institutions  Institution[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

//////////////////////////////////////////////////////
// INSTITUTIONS
//////////////////////////////////////////////////////

model Institution {
  uid                String            @id @default(uuid()) @db.Uuid
  name               String            @db.VarChar(100)
  slug               String            @db.VarChar(50) @unique
  type               InstitutionType   @default(EDUCATIONAL)
  status             InstitutionStatus @default(TRIAL)
  subscriptionPlanId String            @db.Uuid
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?

  /// Cuándo el rector decidió su plan. Null = todavía no decidió, y el
  /// onboarding le muestra la pantalla de planes. Elegir "seguir con el
  /// gratuito" también lo sella: omitir ES una decisión.
  planChosenAt       DateTime?

  subscriptionPlan  SubscriptionPlan       @relation(fields: [subscriptionPlanId], references: [uid])
  userInstitutions  UserInstitution[]
  groups            Groups[]
  invitations       InstitutionInvitation[]
  contentRequests   ContentRequest[]

  events            Events[]
  products          Products[]
  classes           Classes[]
  schedules         Schedule[]
  attendances       Attendance[]
  lessons           Lessons[]
  chapters          Chapters[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserInstitution {
  uid           String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  institutionId String      @db.Uuid
  contextRole   String      @db.VarChar(30)
  isActive      Boolean     @default(true)
  joinedAt      DateTime    @default(now())
  leftAt        DateTime?

  user          Users       @relation(fields: [userId], references: [uid])
  institution   Institution @relation(fields: [institutionId], references: [uid])

  @@unique([userId, institutionId])
  @@index([institutionId, isActive])
}

//////////////////////////////////////////////////////
// GROUP CATEGORIES
//////////////////////////////////////////////////////

model GroupCategory {
  uid       String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(50) @unique
  slug      String   @db.VarChar(30) @unique
  iconSlug  String   @db.VarChar(50)
  isActive  Boolean  @default(true)

  groups    Groups[]
  styles    Styles[]
  requests  ContentRequest[]
  lessons   Lessons[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// INSTITUTION INVITATIONS
//////////////////////////////////////////////////////

model InstitutionInvitation {
  uid           String           @id @default(uuid()) @db.Uuid
  institutionId String           @db.Uuid
  toEmail       String           @db.VarChar(100)
  toUserId      String?          @db.Uuid
  targetRole    String           @db.VarChar(30)
  status        InvitationStatus @default(PENDING)
  token         String           @unique @db.VarChar(64)
  expiresAt     DateTime
  respondedAt   DateTime?

  institution   Institution @relation(fields: [institutionId], references: [uid])
  user          Users?      @relation(fields: [toUserId], references: [uid])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

//////////////////////////////////////////////////////
// CONTENT REQUESTS
//////////////////////////////////////////////////////

model ContentRequest {
  uid           String             @id @default(uuid()) @db.Uuid
  institutionId String             @db.Uuid
  type          ContentRequestType
  requestedName String             @db.VarChar(100)
  categoryId    String?            @db.Uuid
  justification String?            @db.Text
  status        RequestStatus      @default(PENDING)
  reviewNote    String?            @db.Text
  reviewedBy    String?            @db.Uuid
  reviewedAt    DateTime?

  institution   Institution    @relation(fields: [institutionId], references: [uid])
  category      GroupCategory? @relation(fields: [categoryId], references: [uid])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// LESSONS
//////////////////////////////////////////////////////

/// Estado de la lección DENTRO de su institución.
/// DRAFT = el docente la está armando; no la ve nadie más.
enum LessonStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// Estado de la lección en la oferta GLOBAL de la plataforma.
/// Enum aparte y no reutilizado a propósito: no tiene DRAFT (una lección se
/// postula o no se postula) y sus valores no tienen por qué seguir a los del
/// nivel institucional cuando alguno de los dos cambie.
enum LessonGlobalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Lessons {
  uid       String  @id @default(uuid()) @db.Uuid
  title     String  @db.VarChar(120)
  summary   String? @db.VarChar(500)
  isActive  Boolean @default(true)

  /// Portada. Si es null, el frontend cae en la imagen de la categoría,
  /// mismo patrón que Groups.coverPhotoId.
  coverPhotoId String? @db.Uuid
  coverPhoto   Photos? @relation("LessonCover", fields: [coverPhotoId], references: [uid])

  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [uid])

  /// Categoría de la lección: es EL filtro del módulo. Se copia del grupo de
  /// origen al crear, pero es columna propia porque una lección creada por el
  /// rector sin grupo también necesita categoría.
  /// Editable solo mientras institutionStatus es DRAFT.
  categoryId    String        @db.Uuid
  category      GroupCategory @relation(fields: [categoryId], references: [uid])

  /// Grupo desde el cual se creó. NULLABLE a propósito: es la procedencia, no
  /// el dueño. La audiencia de una lección aprobada es toda la institución,
  /// así que el grupo no restringe la lectura.
  groupId  String? @db.Uuid
  group    Groups? @relation(fields: [groupId], references: [uid])

  /// Trazabilidad: quién la creó.
  authorId String @db.Uuid
  author   Users  @relation("LessonAuthor", fields: [authorId], references: [uid])

  // ── Nivel 1: aprobación de la institución ────────────────────────────────
  institutionStatus     LessonStatus @default(DRAFT)
  institutionFeedback   String?      @db.Text
  institutionReviewedBy String?      @db.Uuid
  institutionReviewedAt DateTime?

  // ── Nivel 2: aprobación global de Quyca ──────────────────────────────────
  /// null = el rector nunca la postuló a la oferta global. Los dos niveles son
  /// ejes independientes: aprobar globalmente NO pisa el estado local.
  globalStatus     LessonGlobalStatus?
  globalFeedback   String?             @db.Text
  globalReviewedBy String?             @db.Uuid
  globalReviewedAt DateTime?

  /// Interruptor de visibilidad en el catálogo global. Es la ÚNICA condición
  /// que autoriza una lectura cross-tenant, y por eso viaja siempre dentro del
  /// `where` de esas consultas, nunca en un chequeo posterior (§ 4).
  ///
  /// Significa "visible para toda la plataforma", NO "accesible sin sesión":
  /// el catálogo exige JWT igual que el resto del módulo.
  ///
  /// Se escribe en exactamente dos lugares: la aprobación global del
  /// super_admin y el `unpublish`. Ningún update de la lección la toca.
  isPublic Boolean @default(false)

  chapters Chapters[]
  progress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([institutionId, institutionStatus])
  @@index([globalStatus])
  @@index([isPublic, categoryId])
}

model Chapters {
  uid       String  @id @default(uuid()) @db.Uuid
  lessonId  String  @db.Uuid
  lesson    Lessons @relation(fields: [lessonId], references: [uid])

  /// Orden dentro de la lección, 1..N contiguo. SIN @@unique a propósito:
  /// reordenar reescribe todas las filas en una transacción y una restricción
  /// no diferible choca en los estados intermedios, porque Postgres valida
  /// UNIQUE fila por fila y Prisma no declara constraints DEFERRABLE.
  /// La contigüidad la hace cumplir el servicio.
  sequence  Int
  title     String  @db.VarChar(120)

  /// Contenido en Markdown. Fuente de verdad: si Yoopta se cae o se cambia,
  /// el contenido sigue siendo legible.
  contentMd String  @db.Text

  /// URL externa (YouTube/Vimeo). El archivo de video propio es fase posterior.
  videoUrl  String? @db.VarChar(500)

  isActive  Boolean @default(true)

  /// Desnormalizado igual que Schedule, Classes y Attendance: sin esta columna
  /// el filtrado exigiría un join y quedaría fuera del alcance de la extensión.
  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [uid])

  photos   ChapterPhoto[]
  progress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([lessonId, sequence])
}

/// Tabla puente. Las imágenes del vlog dentro de un capítulo.
model ChapterPhoto {
  uid       String @id @default(uuid()) @db.Uuid
  chapterId String @db.Uuid
  photoId   String @db.Uuid
  sequence  Int    @default(0)

  chapter Chapters @relation(fields: [chapterId], references: [uid])
  photo   Photos   @relation(fields: [photoId], references: [uid])

  createdAt DateTime @default(now())

  @@unique([chapterId, photoId])
}

/// Avance del estudiante. Una fila = un capítulo terminado.
///
/// NO lleva institutionId y NO entra en SCOPED_MODELS, y es la única excepción
/// deliberada del módulo: un usuario avanza en lecciones GLOBALES de otras
/// instituciones, así que etiquetar su progreso con la institución activa del
/// momento sería un dato falso. Se filtra SIEMPRE por userId explícito, igual
/// que una tabla puente.
model LessonProgress {
  uid       String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  chapterId String @db.Uuid

  /// Desnormalizado desde Chapters. Un capítulo nunca cambia de lección, así
  /// que no puede desincronizarse, y evita el join en "continuá donde quedaste".
  lessonId  String @db.Uuid

  user    Users    @relation(fields: [userId], references: [uid])
  chapter Chapters @relation(fields: [chapterId], references: [uid])
  lesson  Lessons  @relation(fields: [lessonId], references: [uid])

  completedAt DateTime @default(now())

  @@unique([userId, chapterId])
  @@index([userId, lessonId])
}
