generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////
enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum EventType {
  EXHIBITION
  WORKSHOP
  PERFORMANCE
  CONFERENCE
  OTHER
}

enum EventPhotoType {
  HERO
  PROMO
  MEMORY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InstitutionType {
  EDUCATIONAL
  INDEPENDENT
}

enum InstitutionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum ContentRequestType {
  CATEGORY
  STYLE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

//////////////////////////////////////////////////////
// USER TYPES
//////////////////////////////////////////////////////

model UserTypes {
  uid        String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(30) @unique

  users      Users[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// ROLES
//////////////////////////////////////////////////////

model Roles {
  uid       String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(50) @unique
  slug      String   @db.VarChar(30) @unique

  users     Users[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////

model Users {
  uid            String    @id @unique @db.Uuid
  name           String    @db.VarChar(30)
  lastName       String    @db.VarChar(30)
  username       String    @db.VarChar(30) @unique
  description    String?   @db.VarChar(500)

  gender         String    @db.VarChar(3)
  telNumber      String    @db.VarChar(12)

  isActive       Boolean   @default(true)

  userType       UserTypes @relation(fields: [userTypeId], references: [uid])
  userTypeId     String    @db.Uuid
  photo          Photos?   @relation("UserPhoto", fields: [photoId], references: [uid])
  photoId        String?   @unique @db.Uuid
  role           Roles?    @relation(fields: [roleId], references: [uid])
  roleId         String?   @db.Uuid
  roleData       Json?

  groups         UsersGroups[]
  products       UserProduct[]
  managedGroups  Groups[]  @relation("GroupProfesor")
  createdEvents  Events[]  @relation("EventCreator")
  attendance     Attendance[]
  userInstitutions       UserInstitution[]
  institutionInvitations InstitutionInvitation[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishAt    DateTime?
}

model Credentials {
  uid              String    @id @default(uuid()) @db.Uuid
  mail             String    @db.VarChar(100) @unique
  password         String    @db.VarChar(250)
  isEmailVerified  Boolean   @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  finishedAt       DateTime?
}

model VerificationCodes {
  uid           String    @id @default(uuid()) @db.Uuid
  credentialUid String    @db.Uuid
  code          String    @db.VarChar(6)
  expiresAt     DateTime
  usedAt        DateTime?

  createdAt     DateTime  @default(now())

  @@index([credentialUid])
}

//////////////////////////////////////////////////////
// GROUPS
//////////////////////////////////////////////////////

model Groups {
  uid          String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  isActive     Boolean  @default(true)

  /// Descripción pública del grupo. La escribe el docente a cargo.
  description  String?  @db.VarChar(500)

  /// Reglas del grupo, texto libre escrito por el docente. Son informativas:
  /// el sistema NO las hace cumplir. Ver
  /// docs/superpowers/specs/2026-08-11-modelo-de-grupos-design.md § 3.
  rules        String?  @db.Text

  /// Portada del grupo, subida por el docente. Si es null, el frontend cae en
  /// la imagen de la categoría (`categoryImage(slug)`).
  coverPhotoId String?  @db.Uuid
  coverPhoto   Photos?  @relation("GroupCover", fields: [coverPhotoId], references: [uid])

  institutionId  String       @db.Uuid
  institution    Institution  @relation(fields: [institutionId], references: [uid])
  categoryId     String       @db.Uuid
  groupCategory  GroupCategory @relation(fields: [categoryId], references: [uid])

  profesor     Users?   @relation("GroupProfesor", fields: [profesorId], references: [uid])
  profesorId   String?  @db.Uuid

  users        UsersGroups[]
  products     Products[]
  events       GroupEvent[]
  styles       Styles[]
  invitations  EventInvitation[]
  schedules    Schedule[]
  classes      Classes[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([institutionId])
}

model UsersGroups {
  uid       String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  groupId   String   @db.Uuid

  user      Users    @relation(fields: [userId], references: [uid])
  group     Groups   @relation(fields: [groupId], references: [uid])

  createdAt DateTime @default(now())

  @@unique([userId, groupId])
}

//////////////////////////////////////////////////////
// PRODUCTS
//////////////////////////////////////////////////////

model Products {
  uid          String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(100)
  description  String        @db.VarChar(500)
  
  status       ProductStatus @default(PENDING)
  feedback     String?       @db.VarChar(300)
  isActive     Boolean       @default(true)

  price        Decimal?      @db.Decimal(10,2)
  isSold       Boolean       @default(false)
  madeAt       DateTime
  
  groupId      String        @db.Uuid
  group        Groups        @relation(fields: [groupId], references: [uid])

  institutionId String       @db.Uuid
  institution   Institution  @relation(fields: [institutionId], references: [uid])

  styles       ProductStyle[]
  photos       ProductPhoto[]
  events       EventProduct[]
  authors      UserProduct[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([institutionId])
  @@index([institutionId, status])
}

//////////////////////////////////////////////////////
// STYLES
//////////////////////////////////////////////////////

model Styles {
  uid          String          @id @default(uuid()) @db.Uuid
  name         String          @db.VarChar(30)
  description  String          @db.VarChar(300)
  isActive     Boolean         @default(true)

  categoryId    String          @db.Uuid
  groupCategory GroupCategory   @relation(fields: [categoryId], references: [uid])

  products     ProductStyle[]

    groupId      String          @db.Uuid
  group        Groups          @relation(fields: [groupId], references: [uid])

  institutionId String         @db.Uuid
  institution   Institution    @relation(fields: [institutionId], references: [uid])

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([institutionId])
}

model ProductStyle {
  uid        String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  styleId    String   @db.Uuid

  product    Products @relation(fields: [productId], references: [uid])
  style      Styles   @relation(fields: [styleId], references: [uid])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, styleId])
}

//////////////////////////////////////////////////////
// PHOTOS
//////////////////////////////////////////////////////

model Photos {
  uid        String         @id @default(uuid()) @db.Uuid
  name       String         @db.VarChar(100)
  url        String         @db.VarChar(500)

  products   ProductPhoto[]
  events     EventPhoto[]
  user       Users?         @relation("UserPhoto")
  groupCovers Groups[] @relation("GroupCover")

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model ProductPhoto {
  uid        String    @id @default(uuid()) @db.Uuid
  productId  String    @db.Uuid
  photoId    String    @db.Uuid
  isMain     Boolean   @default(false)

  product    Products @relation(fields: [productId], references: [uid])
  photo      Photos   @relation(fields: [photoId], references: [uid])

  createdAt  DateTime  @default(now())

  @@unique([productId, photoId])
}

//////////////////////////////////////////////////////
// EVENTS
//////////////////////////////////////////////////////

model Events {
  uid          String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(100)
  description  String      @db.VarChar(1000)
  status       EventStatus @default(PENDING)
  feedback     String?     @db.VarChar(500)
  eventType    EventType   @default(EXHIBITION)
  startDate    DateTime
  endDate      DateTime?
  locationUrl  String?     @db.VarChar(500)
  isVirtual    Boolean     @default(false)
  streamingUrl String?     @db.VarChar(500)
  isActive     Boolean     @default(true)

  createdBy    Users       @relation("EventCreator", fields: [createdById], references: [uid])
  createdById  String      @db.Uuid

  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [uid])

  products     EventProduct[]
  photos       EventPhoto[]
  groups       GroupEvent[]
  invitations  EventInvitation[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([institutionId])
  @@index([institutionId, startDate])
}

model EventProduct {
  uid        String    @id @default(uuid()) @db.Uuid
  productId  String    @db.Uuid
  eventId    String    @db.Uuid

  product    Products @relation(fields: [productId], references: [uid])
  event      Events   @relation(fields: [eventId], references: [uid])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([productId, eventId])
}

model EventInvitation {
  uid         String           @id @default(uuid()) @db.Uuid
  eventId     String           @db.Uuid
  groupId     String           @db.Uuid
  status      InvitationStatus @default(PENDING)

  event       Events  @relation(fields: [eventId], references: [uid])
  group       Groups  @relation(fields: [groupId], references: [uid])

  sentAt      DateTime  @default(now())
  respondedAt DateTime?
  updatedAt   DateTime  @updatedAt  

  @@unique([eventId, groupId])
}

model EventPhoto {
  uid        String         @id @default(uuid()) @db.Uuid
  eventId    String         @db.Uuid
  photoId    String         @db.Uuid
  photoType  EventPhotoType @default(PROMO)

  event      Events  @relation(fields: [eventId], references: [uid])
  photo      Photos  @relation(fields: [photoId], references: [uid])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([eventId, photoId])
}

//////////////////////////////////////////////////////
// USERS ↔ PRODUCTS (AUTHOR)
//////////////////////////////////////////////////////

model UserProduct {
  uid        String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  productId  String    @db.Uuid
  isAuthor   Boolean   @default(false)

  user       Users     @relation(fields: [userId], references: [uid])
  product    Products  @relation(fields: [productId], references: [uid])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, productId])
}

//////////////////////////////////////////////////////
// GROUPS ↔ EVENTS
//////////////////////////////////////////////////////

model GroupEvent {
  uid        String   @id @default(uuid()) @db.Uuid
  groupId    String   @db.Uuid
  eventId    String   @db.Uuid

  group      Groups   @relation(fields: [groupId], references: [uid])
  event      Events   @relation(fields: [eventId], references: [uid])

  createdAt  DateTime @default(now())

  @@unique([groupId, eventId])
}

//////////////////////////////////////////////////////
// SCHEDULE & CLASSES
//////////////////////////////////////////////////////

model Schedule {
  uid        String   @id @default(uuid()) @db.Uuid
  groupId    String   @db.Uuid
  dayOfWeek  Int      // 0=Dom, 1=Lun, 2=Mar, 3=Mié, 4=Jue, 5=Vie, 6=Sáb
  startTime  String   @db.VarChar(5)  // "HH:mm"
  endTime    String   @db.VarChar(5)  // "HH:mm"
  isActive   Boolean  @default(true)

  group      Groups   @relation(fields: [groupId], references: [uid])
  classes    Classes[]

  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [uid])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([institutionId])
}

model Classes {
  uid        String    @id @default(uuid()) @db.Uuid
  groupId    String    @db.Uuid
  scheduleId String?   @db.Uuid  // null = clase manual
  date       DateTime
  startTime  String    @db.VarChar(5)  // "HH:mm"
  endTime    String    @db.VarChar(5)  // "HH:mm"
  topic      String?   @db.VarChar(500)
  review     String?   @db.VarChar(1000)
  isActive   Boolean   @default(true)

  group      Groups    @relation(fields: [groupId], references: [uid])
  schedule   Schedule? @relation(fields: [scheduleId], references: [uid])
  attendance Attendance[]

  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [uid])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([institutionId])
  @@index([institutionId, date])
}

model Attendance {
  uid      String   @id @default(uuid()) @db.Uuid
  classId  String   @db.Uuid
  userId   String   @db.Uuid
  takenAt  DateTime @default(now())

  class    Classes  @relation(fields: [classId], references: [uid])
  user     Users    @relation(fields: [userId], references: [uid])

  institutionId String      @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [uid])

  @@unique([classId, userId])
  @@index([institutionId])
}

//////////////////////////////////////////////////////
// SUBSCRIPTION PLANS
//////////////////////////////////////////////////////

model SubscriptionPlan {
  uid           String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(50) @unique
  slug          String        @db.VarChar(30) @unique
  features      Json
  maxUsers      Int?
  maxGroups     Int?
  priceUsd      Decimal?      @db.Decimal(10,2)
  stripePriceId String?       @db.VarChar(100)
  isActive      Boolean       @default(true)

  institutions  Institution[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

//////////////////////////////////////////////////////
// INSTITUTIONS
//////////////////////////////////////////////////////

model Institution {
  uid                String            @id @default(uuid()) @db.Uuid
  name               String            @db.VarChar(100)
  slug               String            @db.VarChar(50) @unique
  type               InstitutionType   @default(EDUCATIONAL)
  status             InstitutionStatus @default(TRIAL)
  subscriptionPlanId String            @db.Uuid
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?

  /// Cuándo el rector decidió su plan. Null = todavía no decidió, y el
  /// onboarding le muestra la pantalla de planes. Elegir "seguir con el
  /// gratuito" también lo sella: omitir ES una decisión.
  planChosenAt       DateTime?

  subscriptionPlan  SubscriptionPlan       @relation(fields: [subscriptionPlanId], references: [uid])
  userInstitutions  UserInstitution[]
  groups            Groups[]
  invitations       InstitutionInvitation[]
  contentRequests   ContentRequest[]
  offeredCategories InstitutionCategory[]

  events            Events[]
  products          Products[]
  styles            Styles[]
  classes           Classes[]
  schedules         Schedule[]
  attendances       Attendance[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserInstitution {
  uid           String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  institutionId String      @db.Uuid
  contextRole   String      @db.VarChar(30)
  isActive      Boolean     @default(true)
  joinedAt      DateTime    @default(now())
  leftAt        DateTime?

  user          Users       @relation(fields: [userId], references: [uid])
  institution   Institution @relation(fields: [institutionId], references: [uid])

  @@unique([userId, institutionId])
  @@index([institutionId, isActive])
}

//////////////////////////////////////////////////////
// GROUP CATEGORIES
//////////////////////////////////////////////////////

model GroupCategory {
  uid       String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(50) @unique
  slug      String   @db.VarChar(30) @unique
  iconSlug  String   @db.VarChar(50)
  isActive  Boolean  @default(true)

  groups    Groups[]
  styles    Styles[]
  requests  ContentRequest[]
  institutions InstitutionCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Qué categorías del catálogo global oferta cada institución.
///
/// GroupCategory es un catálogo global de 5 filas y no todas las
/// instituciones dictan las 5: la USTA Tunja oferta artes y música, y no
/// debería poder abrir un grupo de teatro. Esta tabla es esa elección, y el
/// rector la edita desde PUT /categories/offered.
///
/// SEMÁNTICA EXPLÍCITA: las filas son EXACTAMENTE lo que la institución
/// oferta. "Sin filas" significa "no oferta nada" y bloquea la creación de
/// grupos — NO significa "todas". Por eso toda institución nace con las 5
/// (ver InstitutionService.createInstitution) y la migración las sembró para
/// las que ya existían. Es la semántica reversible: el rector puede llegar al
/// estado "cero categorías" a propósito y volver, mientras que con
/// "vacío = todas" no habría forma de expresar "ninguna".
///
/// NO va en SCOPED_MODELS, y es deliberado — ver el comentario en
/// tenant.extension.ts. Todo filtro sobre este modelo va escrito a mano.
model InstitutionCategory {
  uid           String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  categoryId    String   @db.Uuid

  institution   Institution   @relation(fields: [institutionId], references: [uid])
  category      GroupCategory @relation(fields: [categoryId], references: [uid])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([institutionId, categoryId])
  @@index([institutionId])
}

//////////////////////////////////////////////////////
// INSTITUTION INVITATIONS
//////////////////////////////////////////////////////

model InstitutionInvitation {
  uid           String           @id @default(uuid()) @db.Uuid
  institutionId String           @db.Uuid
  toEmail       String           @db.VarChar(100)
  toUserId      String?          @db.Uuid
  targetRole    String           @db.VarChar(30)
  status        InvitationStatus @default(PENDING)
  token         String           @unique @db.VarChar(64)
  expiresAt     DateTime
  respondedAt   DateTime?

  institution   Institution @relation(fields: [institutionId], references: [uid])
  user          Users?      @relation(fields: [toUserId], references: [uid])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

//////////////////////////////////////////////////////
// CONTENT REQUESTS
//////////////////////////////////////////////////////

model ContentRequest {
  uid           String             @id @default(uuid()) @db.Uuid
  institutionId String             @db.Uuid
  type          ContentRequestType
  requestedName String             @db.VarChar(100)
  categoryId    String?            @db.Uuid
  justification String?            @db.Text
  status        RequestStatus      @default(PENDING)
  reviewNote    String?            @db.Text
  reviewedBy    String?            @db.Uuid
  reviewedAt    DateTime?

  institution   Institution    @relation(fields: [institutionId], references: [uid])
  category      GroupCategory? @relation(fields: [categoryId], references: [uid])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
