FROM oven/bun:1-alpine AS builder
WORKDIR /app
COPY package.json bun.lock* ./
# --frozen-lockfile o la imagen de producción resuelve dependencias el día del
# build, con versiones que nadie probó. Es la misma clase de bug que el
# `COPY bun.lockb*` que no matcheaba: no falla, no avisa, y se nota meses después.
RUN bun install --frozen-lockfile
COPY . .
RUN bunx prisma generate
RUN bun run build

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts
EXPOSE 3000
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && node dist/src/main"]
